JOBPROOF_PUBLIC_ORIGIN=http://your-server-ip-or-domain
# HTTP/ACME bootstrap only. docker-compose.https.yml overrides this to true.
JOBPROOF_COOKIE_SECURE=false
JOBPROOF_REGISTRATION_ENABLED=false
# Official legal texts (UTF-8 Markdown) placed in deploy/policies/. Production keeps registration
# closed until both files exist; set JOBPROOF_REQUIRE_PUBLISHED_POLICIES=false only for a private beta.
JOBPROOF_TERMS_PATH=/etc/jobproof/policies/terms.md
JOBPROOF_PRIVACY_PATH=/etc/jobproof/policies/privacy.md
JOBPROOF_TERMS_VERSION=2026-10-06-v1
JOBPROOF_PRIVACY_VERSION=2026-10-06-v1
# Operator details shown in the footer and on the legal pages; blank values are hidden.
JOBPROOF_OPERATOR_NAME=
JOBPROOF_OPERATOR_ICP=
JOBPROOF_OPERATOR_PSB=
JOBPROOF_OPERATOR_EMAIL=
JOBPROOF_OPERATOR_PHONE=
JOBPROOF_OPERATOR_ADDRESS=
JOBPROOF_OPERATOR_FEEDBACK_URL=
# One-time production administrator bootstrap. Keep false except during the
# controlled initialization described in docs/项目交接与运行部署指南.md.
JOBPROOF_DEV_ADMIN_ENABLED=false
JOBPROOF_DEV_ADMIN_ALIAS=admin-bootstrap
JOBPROOF_DEV_ADMIN_EMAIL=owner@example.com
JOBPROOF_DEV_ADMIN_PASSWORD=
# MySQL (bundled service). For a managed database set JOBPROOF_DB_URL/JOBPROOF_DB_USERNAME instead
# and remove the mysql service; keep utf8mb4 and the Asia/Shanghai application time zone.
JOBPROOF_DB_PASSWORD=replace-with-random-value
JOBPROOF_DB_ROOT_PASSWORD=replace-with-random-value
JOBPROOF_REDIS_PASSWORD=replace-with-random-value
JOBPROOF_MINIO_ACCESS_KEY=replace-with-random-value
JOBPROOF_MINIO_SECRET_KEY=replace-with-random-value
# Shared secret between the app and the resume renderer (at least 16 characters).
JOBPROOF_RENDERER_TOKEN=replace-with-random-value-32-chars
JOBPROOF_AI_MASTER_KEY=replace-with-base64-32-byte-key
JOBPROOF_CONTACT_HMAC_SECRET=replace-with-random-value
JOBPROOF_EMAIL_CODE_HMAC_SECRET=replace-with-random-value
QQ_SMTP_USER=replace-with-smtp-account
QQ_SMTP_AUTH_CODE=replace-with-smtp-authorization-code
MAIL_FROM=replace-with-sender-address
MAIL_FROM_NAME=JobProof AI
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-access-key-secret
JOBPROOF_ALIYUN_SMS_SIGN_NAME=replace-with-sign-name
JOBPROOF_ALIYUN_SMS_TEMPLATE_CODE=replace-with-template-code
