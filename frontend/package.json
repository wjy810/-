{
  "name": "jobproof-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && vue-tsc -b && vite build --emptyOutDir",
    "test": "npm run test:logic && npm run test:components",
    "test:logic": "node scripts/run-logic-tests.mjs",
    "test:components": "vitest run --config vitest.config.ts",
    "test:e2e:career-planning": "playwright test e2e/career-planning.spec.ts",
    "test:pagination": "node --test src/features/resume/components/resumePreviewPagination.test.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/vue-query": "^5.104.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^15.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.4",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  }
}
